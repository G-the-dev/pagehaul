# Create an API key at https://resend.com/api-keys and set it in your local
# .env.local file or your deployment provider's environment settings.
RESEND_API_KEY=re_replace_with_your_resend_api_key

# Resend requires this sender to use a domain you have verified in Resend.
# Example: pagehaul <contact@your-verified-domain.com>
FEEDBACK_FROM=pagehaul <onboarding@resend.dev>

# Contact-form messages go here. This defaults to pagehaul.contact@gmail.com
# when omitted, but setting it explicitly makes the delivery destination clear.
FEEDBACK_TO=pagehaul.contact@gmail.com
